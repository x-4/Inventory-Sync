[Unit]
Description=Enterprise Inventory Real-Time Synchronization Microservice
Documentation=https://github.com/x-4/Inventory-Sync
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/enterprise-inventory-sync
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOST=0.0.0.0
Environment=NODE_OPTIONS="--max-old-space-size=160"
Environment=UV_THREADPOOL_SIZE=64
EnvironmentFile=-/opt/enterprise-inventory-sync/.env
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=3s
KillMode=mixed
TimeoutStopSec=15s
LimitNOFILE=65535
LimitNPROC=4096
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
